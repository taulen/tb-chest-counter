# TB Chest Counter Configuration
# Copy this file to .env and fill in your values.
#
# NOTE: runtime settings changed via the admin UI are persisted to
# data/app.env (a mounted volume), which is loaded AFTER this file and wins.
# Scanner/UI calibration (click points, crop rectangles) and the source-point
# scoring table are managed entirely in-app and live in app.env / the DB —
# they are intentionally not listed here.

# ── OCR ───────────────────────────────────────────────────────────────────
# OCR is PaddleOCR (PP-OCRv6_small via ONNX Runtime); there is no engine toggle.
# Re-OCR name regions that read as empty/non-Latin with the bundled Cyrillic +
# Arabic models (recovers non-Latin player names).
SCAN_NON_LATIN_FALLBACK=true

# ── ONNX Runtime tuning ───────────────────────────────────────────────────
# Intra-op thread count for PaddleOCR inference. Must be explicit (any value ≥1)
# so ONNX Runtime doesn't attempt pthread_setaffinity_np (which fails in Docker).
# 4 is a good balance; lower it toward 1 if OCR CPU ever competes with the
# browser. (OMP_NUM_THREADS=1 is also set in the Dockerfile as belt-and-braces.)
ONNX_INTRA_OP_THREADS=4

# ── Game / scan settings ──────────────────────────────────────────────────
# The Total Battle game URL is hardcoded in src/config/game-url.ts.
SCAN_INTERVAL_MS=7200000
HEADLESS=true
# Runaway-loop ceiling on how many chests one sweep of a tab may open. Not a
# target: a healthy sweep stops when the tab runs dry. Superadmin-settable on
# the System page (rounded up to a whole batch of 4 clicks).
SCAN_MAX_CHESTS=2000
# How many of the first capture-phase iterations save an annotated debug
# screenshot to data/screenshots/ (0 disables).
SCAN_DEBUG_FIRST_N=10
# Forensic: persist the raw OCR'd player name on each chest record. Off by
# default — the column otherwise balloons the DB.
ENABLE_RAW_OCR_CAPTURE=false
# Hour-of-day in UTC (0-23) when the in-game global day rolls over. Drives the
# Discord daily digest and every "which day" grouping across the app.
GAME_DAY_ROLLOVER_UTC_HOUR=17

# ── Daily capture phases ───────────────────────────────────────────
# Both run AFTER a scan is finalised and both swallow every error by design —
# neither can ever fail a scan. ON by default, and each still gates itself on
# its own calibration, so on a fresh install "enabled" means "starts the moment
# it can", not "runs now". Set false to opt out entirely; both are also
# toggleable from the System page.
#
# Might: the daily member might/level snapshot. Blocked until calibration
# Stage 4 has been re-saved with the might column inside the rectangle.
MIGHT_TRACKING_ENABLED=true
# Resources: the daily Clan Capital resource-history read. Blocked until
# Stages 5 + 6 are calibrated, and skipped per-clan for any clan with resource
# tracking off or excluded from the daily read (Clans → Resource Tracking).
RESOURCE_CAPTURE_ENABLED=true

# ── Web Dashboard ─────────────────────────────────────────────────────────
WEB_ENABLED=true
WEB_PORT=3000
# Public-facing dashboard URL used in Discord embeds (empty = no links).
WEB_EXTERNAL_URL=

# Discord is configured per-clan from the in-app Clans page (token, channel,
# guild, and feature toggles all live in the clans table).

# ── Docker ───────────────────────────────────────────────────
# Host port mapped to the container's 3000.
HOST_WEB_PORT=3010
#
# The two below are ONLY for running a second instance beside a live one
# (see "Running a second instance" in the README). A normal install leaves
# them unset.
#   DATA_VOLUME    — the named volume holding the DB, auth and settings. A
#                    second instance MUST have its own, or it adopts the live
#                    database and boots straight past setup — silently testing
#                    nothing.
#   INSTANCE_NAME  — an explicit container name. Rarely needed: the Compose
#                    project name already keeps containers apart, and
#                    platforms that ignore container_name (Swarm) ignore this
#                    too.
# DATA_VOLUME=tb-chest-data-scratch
# INSTANCE_NAME=tb-chest-counter-scratch

# ── Logging ───────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Storage ───────────────────────────────────────────────────────────────
DB_PATH=./data/tb-chests.db
# Legacy storage-state path. The first multi-clan boot relocates this file to
# ./data/clans/1/storage-state.json automatically. New clans capture their own
# auth via the in-app login bridge per-clan.
STORAGE_STATE_PATH=./data/auth/storage-state.json
SCREENSHOT_RETENTION_DAYS=3
