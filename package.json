{
  "name": "tb-chest-counter",
  "version": "0.1.0",
  "private": true,
  "description": "Starter workspace for TB chest counter project",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run guards && tsc -p tsconfig.json",
    "guards": "vitest run tests/config",
    "start": "node dist/index.js",
    "start:ts": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "dashboard": "node dist/index.js --dashboard-only",
    "reset-setup": "node scripts/reset-setup.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check": "npm run typecheck && npm run test:run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/ui": "^5.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "onnxruntime-node": "^1.27.0",
    "paddleocr": "^1.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  }
}
